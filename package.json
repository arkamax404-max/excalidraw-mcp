{
  "name": "excalidraw-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets agents create, list, read and delete Excalidraw diagrams in the self-hosted Excalidraw fork.",
  "main": "dist/server.js",
  "bin": {
    "excalidraw-mcp": "dist/server.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:converter && npm run build:export && tsc -p tsconfig.json",
    "build:converter": "esbuild --bundle --platform=node --format=esm --outfile=dist/vendor/excalidraw-converter.mjs --log-level=warning scripts/converter-entry.mjs",
    "build:export": "esbuild --bundle --platform=browser --format=iife --global-name=Ex --outfile=dist/vendor/excalidraw-export.js --log-level=warning scripts/export-entry.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "spike:mermaid": "npm run build:converter && node scripts/spike-mermaid.mjs",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.6",
    "jsdom": "^27.0.0",
    "mermaid": "11.15.0",
    "playwright": "^1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
