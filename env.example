# Connection to the self-hosted Excalidraw fork.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and is
# never written by the agent: the human owns the credentials.

# Base URL of the Excalidraw server. Defaults to http://localhost:3030.
EXCALIDRAW_BASE_URL=http://localhost:3030

# The user that owns every diagram this MCP instance creates.
EXCALIDRAW_USERNAME=

# Password of that user. Never commit the real value.
EXCALIDRAW_PASSWORD=

# Optional request timeout in milliseconds. Defaults to 30000.
# EXCALIDRAW_TIMEOUT_MS=30000
